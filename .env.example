NODE_ENV=development
PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/gadgetzone?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_key

# PayHere Config
PAYHERE_MERCHANT_ID=your_payhere_merchant_id
PAYHERE_MERCHANT_SECRET=your_payhere_merchant_secret
PAYHERE_MODE=sandbox

# Google OAuth Config
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# SendGrid Email Notification Config
SENDGRID_API_KEY=SG.your_sendgrid_api_key
SENDGRID_FROM_EMAIL=noreply@gadgetzone.lk
SENDGRID_FROM_NAME=GadgetZone

# Supabase Storage Config (Optional - for direct product image uploads)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_BUCKET=product-images
